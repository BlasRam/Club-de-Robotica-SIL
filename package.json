{
  "name": "robotica-sil-pwa",
  "private": true,
  "type": "module",
  "scripts": {
    "web:dev": "vite --config web/vite.config.ts --host 0.0.0.0",
    "web:build": "vite build --config web/vite.config.ts",
    "rules:build": "node scripts/build-firestore-rules.mjs",
    "rules:deploy": "firebase deploy --only firestore:rules",
    "test:rules": "firebase emulators:exec --project cdr-firestore-rules-tests --only firestore \"node --test tests/firestore.rules.test.mjs\"",
    "test:worker": "node --test workers/notifications/test/*.test.js"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.10.0",
    "firebase-tools": "^15.32.1",
    "lucide-static": "^1.55.0",
    "vite": "^8.3.4"
  }
}

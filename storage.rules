rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isClubAdministrator() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.rol == "admin";
    }

    match /club-assets/branding/{fileName} {
      allow read: if true;
      allow create, update: if isClubAdministrator()
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType == "image/webp";
      allow delete: if isClubAdministrator();
    }
  }
}

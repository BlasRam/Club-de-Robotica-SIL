rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isClubAdministrator() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.rol == "admin";
    }

    function isAuthorizedClubUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.autorizado == true;
    }

    function canManageProjectEvidence(projectId) {
      let user = firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data;
      let project = firestore.get(/databases/(default)/documents/proyectos/$(projectId)).data;
      return isAuthorizedClubUser()
        && (user.rol in ["admin", "moderador"]
          || project.get("responsableUid", "") == request.auth.uid
          || project.get("creadoPorUid", "") == request.auth.uid);
    }

    function isApprovedShowcaseImage(projectId, fileName) {
      let showcase = firestore.get(/databases/(default)/documents/guiasClub/$(projectId)).data;
      return request.auth != null
        && request.auth.token.email_verified == true
        && fileName.matches("showcase-[A-Za-z0-9_-]+")
        && showcase.get("estado", "") == "aprobada"
        && showcase.get("fotoPath", "") == "proyectos/" + projectId + "/evidencias/" + fileName;
    }

    match /club-assets/branding/{fileName} {
      allow read: if true;
      allow create, update: if isClubAdministrator()
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType == "image/webp";
      allow delete: if isClubAdministrator();
    }

    match /proyectos/{projectId}/evidencias/{fileName} {
      allow read: if isAuthorizedClubUser() || isApprovedShowcaseImage(projectId, fileName);
      allow create: if canManageProjectEvidence(projectId)
        && request.resource.size <= 4 * 1024 * 1024
        && request.resource.contentType.matches("image/(jpeg|png|webp)");
      allow update, delete: if false;
    }
  }
}

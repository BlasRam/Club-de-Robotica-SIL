// =====================================================
// INVENTARIO
// =====================================================

match /inventario/{itemId} {
  function validStockMovement() {
    let event = getAfter(/databases/$(database)/documents/actividadAdmin/$(request.resource.data.ultimoMovimientoId)).data;
    let difference = resource.data.cantidad > request.resource.data.cantidad
      ? resource.data.cantidad - request.resource.data.cantidad
      : request.resource.data.cantidad - resource.data.cantidad;
    return request.resource.data.ultimoMovimientoId is string
      && request.resource.data.ultimoMovimientoId != resource.data.get("ultimoMovimientoId", "")
      && event.inventarioId == itemId
      && event.stockAnterior == resource.data.cantidad
      && event.stockNuevo == request.resource.data.cantidad
      && event.cantidad == difference
      && (
        event.tipo == "inventario_conteo"
        ? event.conteoFisico == request.resource.data.cantidad
        : (
          difference > 0
          && (
            request.resource.data.cantidad > resource.data.cantidad
            ? event.tipo in ["inventario_entrada", "prestamo_devuelto"]
            : event.tipo in ["inventario_salida", "prestamo_aprobado"]
          )
        )
      );
  }

  function validConditionMovement() {
    let event = getAfter(/databases/$(database)/documents/actividadAdmin/$(request.resource.data.ultimoEventoCondicionId)).data;
    let previousDamaged = resource.data.get("cantidadDanada", 0);
    let nextDamaged = request.resource.data.get("cantidadDanada", 0);
    let difference = previousDamaged > nextDamaged
      ? previousDamaged - nextDamaged
      : nextDamaged - previousDamaged;
    return request.resource.data.ultimoEventoCondicionId is string
      && request.resource.data.ultimoEventoCondicionId != resource.data.get("ultimoEventoCondicionId", "")
      && event.tipo == "inventario_condicion_actualizada"
      && event.inventarioId == itemId
      && event.entidadId == itemId
      && event.cantidadDanadaAnterior == previousDamaged
      && event.cantidadDanadaNueva == nextDamaged
      && event.cantidad == difference
      && event.detalleCondicion == request.resource.data.get("detalleDanio", "")
      && (
        event.operacionCondicion == "reportar_dano"
        ? (
          nextDamaged > previousDamaged
          && request.resource.data.cantidad == resource.data.cantidad
        )
        : event.operacionCondicion == "reparar"
          ? (
            nextDamaged < previousDamaged
            && request.resource.data.cantidad == resource.data.cantidad
          )
          : event.operacionCondicion == "retirar_danado"
            ? (
              nextDamaged < previousDamaged
              && resource.data.cantidad - request.resource.data.cantidad == difference
              && request.resource.data.ultimoMovimientoId is string
              && request.resource.data.ultimoMovimientoId != resource.data.get("ultimoMovimientoId", "")
              && getAfter(/databases/$(database)/documents/actividadAdmin/$(request.resource.data.ultimoMovimientoId)).data.tipo == "inventario_salida"
              && getAfter(/databases/$(database)/documents/actividadAdmin/$(request.resource.data.ultimoMovimientoId)).data.inventarioId == itemId
              && getAfter(/databases/$(database)/documents/actividadAdmin/$(request.resource.data.ultimoMovimientoId)).data.stockAnterior == resource.data.cantidad
              && getAfter(/databases/$(database)/documents/actividadAdmin/$(request.resource.data.ultimoMovimientoId)).data.stockNuevo == request.resource.data.cantidad
              && getAfter(/databases/$(database)/documents/actividadAdmin/$(request.resource.data.ultimoMovimientoId)).data.cantidad == difference
            )
            : false
      );
  }

  allow read: if estaAutorizado() || esAdministrador();

  allow create: if
    esAdministrador()
    && request.resource.data.keys().hasOnly([
      "nombre", "descripcion", "categoria", "cantidad", "ubicacion", "estado",
      "creadoPorUid", "creadoPorNombre", "fechaCreacion", "imagenPath", "imagenCatalogo",
      "ultimoMovimientoId", "stockMinimo", "ubicacionDetalle", "unidadInventario",
      "cantidadDanada", "detalleDanio"
    ])
    && request.resource.data.keys().hasAll([
      "nombre", "descripcion", "categoria", "cantidad", "ubicacion", "estado",
      "creadoPorUid", "creadoPorNombre", "fechaCreacion"
    ])
    && request.resource.data.nombre is string
    && request.resource.data.nombre.size() > 0
    && request.resource.data.nombre.size() <= 100
    && request.resource.data.descripcion is string
    && request.resource.data.descripcion.size() <= 1000
    && request.resource.data.categoria is string
    && request.resource.data.categoria.size() <= 80
    && request.resource.data.cantidad is int
    && request.resource.data.cantidad >= 0
    && request.resource.data.ubicacion is string
    && request.resource.data.ubicacion.size() <= 120
    && request.resource.data.estado in ["Disponible", "Prestado", "Mantenimiento", "Baja"]
    && request.resource.data.creadoPorUid == request.auth.uid
    && request.resource.data.creadoPorNombre is string
    && request.resource.data.fechaCreacion is timestamp
    && (!request.resource.data.keys().hasAny(["stockMinimo"])
      || (request.resource.data.stockMinimo is int && request.resource.data.stockMinimo >= 0))
    && (!request.resource.data.keys().hasAny(["ubicacionDetalle"])
      || (request.resource.data.ubicacionDetalle is string && request.resource.data.ubicacionDetalle.size() <= 120))
    && (!request.resource.data.keys().hasAny(["unidadInventario"])
      || request.resource.data.unidadInventario in ["unidad", "paquete", "kit", "par", "lote"])
    && (!request.resource.data.keys().hasAny(["cantidadDanada"])
      || (request.resource.data.cantidadDanada is int
        && request.resource.data.cantidadDanada == 0
        && request.resource.data.cantidadDanada <= request.resource.data.cantidad))
    && (!request.resource.data.keys().hasAny(["detalleDanio"])
      || (request.resource.data.detalleDanio is string && request.resource.data.detalleDanio.size() <= 300))
    && (
      request.resource.data.cantidad == 0
      ? !request.resource.data.keys().hasAny(["ultimoMovimientoId"])
      : (
        request.resource.data.ultimoMovimientoId is string
        && getAfter(/databases/$(database)/documents/actividadAdmin/$(request.resource.data.ultimoMovimientoId)).data.inventarioId == itemId
        && getAfter(/databases/$(database)/documents/actividadAdmin/$(request.resource.data.ultimoMovimientoId)).data.tipo == "inventario_entrada"
        && getAfter(/databases/$(database)/documents/actividadAdmin/$(request.resource.data.ultimoMovimientoId)).data.stockAnterior == 0
        && getAfter(/databases/$(database)/documents/actividadAdmin/$(request.resource.data.ultimoMovimientoId)).data.stockNuevo == request.resource.data.cantidad
        && getAfter(/databases/$(database)/documents/actividadAdmin/$(request.resource.data.ultimoMovimientoId)).data.cantidad == request.resource.data.cantidad
      )
    )
    && (!request.resource.data.keys().hasAny(["imagenPath"])
      || (request.resource.data.imagenPath is string
        && request.resource.data.imagenPath.matches('^inventario/' + itemId + '/foto-[A-Za-z0-9_-]+\\.webp$')))
    && (!request.resource.data.keys().hasAny(["imagenCatalogo"])
      || (request.resource.data.imagenCatalogo is string
        && request.resource.data.imagenCatalogo.matches('^assets/inventory/[A-Za-z0-9_-]+\\.webp$')));

  allow update: if
    esAdministrador()
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
      "estado", "cantidad", "imagenPath", "imagenCatalogo", "ultimoMovimientoId",
      "stockMinimo", "ubicacion", "ubicacionDetalle", "unidadInventario",
      "cantidadDanada", "detalleDanio", "ultimoEventoCondicionId"
    ])
    && request.resource.data.cantidad is int
    && request.resource.data.cantidad >= 0
    && request.resource.data.estado in ["Disponible", "Prestado", "Mantenimiento", "Baja"]
    && (!request.resource.data.keys().hasAny(["stockMinimo"])
      || (request.resource.data.stockMinimo is int && request.resource.data.stockMinimo >= 0))
    && (!request.resource.data.keys().hasAny(["ubicacion"])
      || (request.resource.data.ubicacion is string && request.resource.data.ubicacion.size() <= 120))
    && (!request.resource.data.keys().hasAny(["ubicacionDetalle"])
      || (request.resource.data.ubicacionDetalle is string && request.resource.data.ubicacionDetalle.size() <= 120))
    && (!request.resource.data.keys().hasAny(["unidadInventario"])
      || request.resource.data.unidadInventario in ["unidad", "paquete", "kit", "par", "lote"])
    && (!request.resource.data.keys().hasAny(["cantidadDanada"])
      || (request.resource.data.cantidadDanada is int
        && request.resource.data.cantidadDanada >= 0
        && request.resource.data.cantidadDanada <= request.resource.data.cantidad))
    && (!request.resource.data.keys().hasAny(["detalleDanio"])
      || (request.resource.data.detalleDanio is string && request.resource.data.detalleDanio.size() <= 300))
    && (!request.resource.data.keys().hasAny(["imagenPath"])
      || (request.resource.data.imagenPath is string
        && request.resource.data.imagenPath.matches('^inventario/' + itemId + '/foto-[A-Za-z0-9_-]+\\.webp$')))
    && (!request.resource.data.keys().hasAny(["imagenCatalogo"])
      || (request.resource.data.imagenCatalogo is string
        && request.resource.data.imagenCatalogo.matches('^assets/inventory/[A-Za-z0-9_-]+\\.webp$')))
    && (
      request.resource.data.diff(resource.data).affectedKeys().hasAny(["cantidad", "ultimoMovimientoId"])
      ? validStockMovement()
      : !request.resource.data.diff(resource.data).affectedKeys().hasAny(["ultimoMovimientoId"])
    )
    && (
      request.resource.data.diff(resource.data).affectedKeys().hasAny(["cantidadDanada", "detalleDanio", "ultimoEventoCondicionId"])
      ? validConditionMovement()
      : !request.resource.data.diff(resource.data).affectedKeys().hasAny(["ultimoEventoCondicionId"])
    );

  allow delete: if esAdministrador();
}
